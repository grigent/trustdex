{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grigent/trustdex/blob/main/schemas/permission-posture-diff-v1.schema.json",
  "title": "TrustDex permission posture diff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtime",
    "status",
    "baselineDigest",
    "currentDigest",
    "summary",
    "changes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runtime": { "enum": ["claude", "codex"] },
    "status": { "enum": ["unchanged", "restricted", "needs-review"] },
    "baselineDigest": { "$ref": "#/$defs/digest" },
    "currentDigest": { "$ref": "#/$defs/digest" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expansions", "restrictions", "reviews"],
      "properties": {
        "expansions": { "$ref": "#/$defs/count" },
        "restrictions": { "$ref": "#/$defs/count" },
        "reviews": { "$ref": "#/$defs/count" }
      }
    },
    "changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/change" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "scalar": {
      "type": ["string", "number", "boolean", "null"]
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["impact", "type", "field"],
      "properties": {
        "impact": { "enum": ["expansion", "restriction", "review"] },
        "type": {
          "enum": [
            "policy-changed",
            "items-added",
            "items-removed",
            "decision-changed",
            "count-changed",
            "boolean-changed",
            "value-changed"
          ]
        },
        "field": { "type": "string" },
        "before": { "$ref": "#/$defs/scalar" },
        "after": { "$ref": "#/$defs/scalar" },
        "items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    }
  }
}
