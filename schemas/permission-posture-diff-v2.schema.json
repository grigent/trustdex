{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grigent/trustdex/blob/main/schemas/permission-posture-diff-v2.schema.json",
  "title": "TrustDex merged permission posture diff v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtime",
    "status",
    "baselineDigest",
    "currentDigest",
    "summary",
    "changes"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "runtime": { "enum": ["claude", "codex"] },
    "status": { "enum": ["unchanged", "restricted", "needs-review"] },
    "baselineDigest": { "$ref": "permission-posture-diff-v1.schema.json#/$defs/digest" },
    "currentDigest": { "$ref": "permission-posture-diff-v1.schema.json#/$defs/digest" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expansions", "restrictions", "reviews"],
      "properties": {
        "expansions": { "$ref": "permission-posture-diff-v1.schema.json#/$defs/count" },
        "restrictions": { "$ref": "permission-posture-diff-v1.schema.json#/$defs/count" },
        "reviews": { "$ref": "permission-posture-diff-v1.schema.json#/$defs/count" }
      }
    },
    "changes": {
      "type": "array",
      "items": { "$ref": "permission-posture-diff-v1.schema.json#/$defs/change" }
    }
  }
}
