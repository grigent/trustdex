{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grigent/trustdex/blob/main/schemas/runtime-tool-inventory-attestation-v1.schema.json",
  "title": "TrustDex signed runtime tool inventory attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "kind", "algorithm", "inventoryDigest", "runtime", "capturedAt",
    "captureMethod", "producerKeyId", "createdAt", "expiresAt", "signature"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "agent-runtime-tool-inventory-attestation" },
    "algorithm": { "const": "ed25519" },
    "inventoryDigest": { "$ref": "#/$defs/digest" },
    "runtime": { "enum": ["claude", "codex"] },
    "capturedAt": { "type": "string", "format": "date-time" },
    "captureMethod": { "enum": ["runtime-export", "runtime-adapter"] },
    "producerKeyId": { "$ref": "#/$defs/digest" },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
